---
import SiteLayout from "../layouts/SiteLayout.astro";

const projects = Object.values(
  import.meta.glob("./projects/*.md", { eager: true })
) as any[];
---
<SiteLayout title="GOJO Designs — Interior Design & Bespoke Furniture">

  <!-- Hero -->
  <section class="relative h-[92vh] min-h-[560px] flex items-end overflow-hidden">
    <img
      src="https://images.unsplash.com/photo-1618221195710-dd6b41faaea6?w=1800&q=80&auto=format"
      alt="PLACEHOLDER — replace with real project photography"
      class="absolute inset-0 w-full h-full object-cover"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-ink/85 via-ink/25 to-ink/10"></div>
    <div class="relative max-w-6xl mx-auto px-6 md:px-8 pb-16 w-full text-paper">
      <p class="uppercase tracking-[0.25em] text-xs mb-5 text-paper/80">
        Interior Design &amp; Bespoke Furniture
      </p>
      <h1 class="font-display font-normal italic text-[2.6rem] leading-[1.1] md:text-7xl md:leading-[1.05] max-w-3xl">
        Rooms built around how you actually live in them.
      </h1>
    </div>
  </section>

  <!-- Studio strip -->
  <section id="studio" class="max-w-6xl mx-auto px-6 md:px-8 py-24 md:py-32 grid md:grid-cols-5 gap-12 md:gap-16">
    <div class="md:col-span-2">
      <div class="aspect-[4/5] overflow-hidden bg-plaster-dim">
        <img
          src="https://images.unsplash.com/photo-1600585154340-be6161a56a0c?w=900&q=80&auto=format"
          alt="PLACEHOLDER — studio / designer portrait"
          class="w-full h-full object-cover"
        />
      </div>
    </div>
    <div class="md:col-span-3 flex flex-col justify-center">
      <p class="uppercase tracking-[0.2em] text-xs text-moss mb-4">The Studio</p>
      <h2 class="font-display text-3xl md:text-[2.4rem] leading-tight mb-6 max-w-lg">
        Every piece is drawn before it's built — nothing is chosen off a shelf.
      </h2>
      <p class="text-ink-soft leading-relaxed max-w-md">
        GOJO Designs works across full interiors and standalone furniture commissions,
        pairing considered material choices with joinery built to be looked at closely.
        Each project starts on site, not in a catalogue.
      </p>
    </div>
  </section>

  <!-- Work -->
  <section id="work" class="max-w-6xl mx-auto px-6 md:px-8 py-16 md:py-24 border-t border-ink/10">
    <div class="flex items-end justify-between mb-14">
      <h2 class="font-display text-3xl md:text-4xl">Selected Work</h2>
      <p class="hidden md:block text-sm text-ink-soft">{projects.length} projects</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-x-10 gap-y-16">
      {projects.map((project: any) => (
        <a href={project.url} class="group block joint-frame">
          <div class="aspect-[4/3] overflow-hidden bg-plaster-dim mb-5">
            <img
              src={project.frontmatter.image}
              alt={project.frontmatter.title}
              class="w-full h-full object-cover grayscale-[15%] group-hover:grayscale-0 group-hover:scale-[1.03] transition-all duration-700 ease-out"
            />
          </div>
          <p class="uppercase tracking-[0.15em] text-xs text-moss mb-1.5">
            {project.frontmatter.category}
          </p>
          <h3 class="font-display text-xl md:text-2xl">{project.frontmatter.title}</h3>
        </a>
      ))}
    </div>
  </section>

  <!-- Contact -->
  <section id="contact" class="max-w-6xl mx-auto px-6 md:px-8 py-24 md:py-32 border-t border-ink/10">
    <div class="max-w-xl">
      <p class="uppercase tracking-[0.2em] text-xs text-moss mb-4">Start a Project</p>
      <h2 class="font-display text-3xl md:text-4xl leading-tight mb-6">
        Tell us about the space, and what isn't working about it yet.
      </h2>
      <p class="text-ink-soft leading-relaxed mb-8">
        Commissions open for full interiors, single rooms, and standalone furniture pieces.
        Reply within two working days.
      </p>
      <a
        href="mailto:gauricj@gojodesigns.com"
        class="inline-block text-sm tracking-[0.1em] uppercase border border-ink px-6 py-3.5 hover:bg-ink hover:text-paper transition-colors"
      >
        gauricj@gojodesigns.com
      </a>
    </div>
  </section>

</SiteLayout>
