---
import '../styles/global.css';

// Modern Vite file scanner replacing the deprecated Astro.glob
const projects = Object.values(import.meta.glob('./projects/*.md', { eager: true }));
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Studio Portfolio</title>
  </head>
  <body class="bg-zinc-50 text-zinc-900 font-sans antialiased">
    
    <!-- Navigation -->
    <nav class="p-6 border-b border-zinc-200 flex justify-between items-center">
      <h1 class="text-2xl font-bold tracking-tighter">STUDIO NAME</h1>
      <a href="mailto:hello@studio.com" class="text-sm font-medium hover:text-zinc-500 transition-colors">Contact</a>
    </nav>

    <!-- Hero Section -->
    <main class="max-w-7xl mx-auto px-6 py-24">
      <h2 class="text-5xl md:text-7xl font-bold tracking-tight mb-6">
        Tactile design for <br class="hidden md:block" />modern spaces.
      </h2>
      <p class="text-lg text-zinc-600 max-w-xl mb-12">
        Showcasing bespoke furniture, interior concepts, and industrial design.
      </p>
      
      <!-- Dynamic Portfolio Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 border-t border-zinc-200 pt-12" id="portfolio-grid">
         
        {projects.map((project) => (
          <a href={project.url} class="group block">
            <div class="aspect-[4/3] overflow-hidden bg-zinc-200 rounded-lg mb-4">
              <img 
                src={project.frontmatter.image} 
                alt={project.frontmatter.title}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              />
            </div>
            <p class="text-sm text-zinc-500 uppercase tracking-wider mb-1">{project.frontmatter.category}</p>
            <h3 class="text-xl font-medium">{project.frontmatter.title}</h3>
          </a>
        ))}

      </div>
    </main>

  </body>
</html>