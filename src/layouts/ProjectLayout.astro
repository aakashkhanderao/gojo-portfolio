---
import '../styles/global.css';

// This pulls the frontmatter data from whichever Markdown file is using this layout
const { frontmatter } = Astro.props;
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{frontmatter.title} | Studio Name</title>
  </head>
  <body class="bg-zinc-50 text-zinc-900 font-sans antialiased">
    
    <!-- Navigation (Includes a link back to Home) -->
    <nav class="p-6 border-b border-zinc-200 flex justify-between items-center">
      <a href="/" class="text-2xl font-bold tracking-tighter hover:text-zinc-500 transition-colors">STUDIO NAME</a>
      <a href="mailto:hello@studio.com" class="text-sm font-medium hover:text-zinc-500 transition-colors">Contact</a>
    </nav>

    <!-- Product Detail Section -->
    <main class="max-w-5xl mx-auto px-6 py-16">
      
      <!-- Header block -->
      <div class="mb-10">
        <a href="/" class="text-sm text-zinc-500 hover:text-zinc-900 mb-4 inline-block">&larr; Back to Portfolio</a>
        <p class="text-sm text-zinc-500 uppercase tracking-wider mb-2">{frontmatter.category}</p>
        <h1 class="text-4xl md:text-6xl font-bold tracking-tight">{frontmatter.title}</h1>
      </div>
      
      <!-- Hero Image -->
      <img 
        src={frontmatter.image} 
        alt={frontmatter.title} 
        class="w-full aspect-video object-cover rounded-lg mb-12 bg-zinc-200" 
      />
      
      <!-- Markdown Content Injection Point -->
      <div class="text-lg leading-relaxed text-zinc-700 max-w-3xl">
        <slot />
      </div>

    </main>

  </body>
</html>