---
import SiteLayout from "./SiteLayout.astro";

const { frontmatter } = Astro.props;
---
<SiteLayout title={`${frontmatter.title} — GOJO Designs`}>
  <main class="max-w-5xl mx-auto px-6 md:px-8 py-16 md:py-20">
    <a href="/#work" class="inline-flex items-center gap-2 text-sm text-ink-soft hover:text-ink transition-colors mb-10">
      &larr; Back to Work
    </a>

    <p class="uppercase tracking-[0.2em] text-xs text-moss mb-3">{frontmatter.category}</p>
    <h1 class="font-display text-4xl md:text-6xl leading-tight mb-12 max-w-3xl">{frontmatter.title}</h1>

    <div class="aspect-video overflow-hidden bg-plaster-dim mb-14">
      <img
        src={frontmatter.image}
        alt={frontmatter.title}
        class="w-full h-full object-cover"
      />
    </div>

    <div class="prose-content text-lg leading-relaxed text-ink-soft max-w-2xl">
      <slot />
    </div>
  </main>
</SiteLayout>
